{
  "name": "edusmart",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev --workspace @edusmart/backend\" \"npm:dev --workspace @edusmart/frontend\"",
    "build": "npm run build --workspace @edusmart/frontend",
    "start": "npm run start --workspace @edusmart/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
